# hmemory environment configuration
# Copy to .env and fill in your values.

# Server
PORT=8080

# Database
DATABASE_URL=postgres://postgres:hmemory@localhost:5432/hmemory

# Embedding provider: "openrouter" or "ollama" (required)
EMBEDDING_PROVIDER=ollama

# OpenRouter (required when EMBEDDING_PROVIDER=openrouter)
# OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=openai/text-embedding-3-small

# Ollama (required when EMBEDDING_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=nomic-embed-text

# Hybrid search: 0.0 = pure BM25, 1.0 = pure vector
HYBRID_ALPHA=0.5

# Memory decay: half-life in days for time-weighted scoring
DECAY_HALF_LIFE_DAYS=30

# Conservative sync_turn: minimum importance score to store a turn
SYNC_TURN_MIN_IMPORTANCE=0.3

# Cadence: min turns between prefetch fetches
PREFETCH_CADENCE=1

# Cadence: min turns between sync_turn stores
SYNC_TURN_CADENCE=1

# Cadence: min turns between conclusion generation
CONCLUSION_CADENCE=10

# Max tokens for prefetch context (empty = uncapped)
# CONTEXT_TOKENS=2000

# Cadence: regenerate base context every N turns
BASE_CONTEXT_CADENCE=5

# Reranking: cross-encoder reranking (requires OpenRouter)
# RERANK_ENABLED=true
# RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Batch processing: max memories per batch
BATCH_SIZE=20

# Batch processing: idle seconds before flush
BATCH_IDLE_SECONDS=300

# Fresh TTL: hours before a memory is considered stale
FRESH_TTL_HOURS=48

# Consolidation: turns between consolidation passes
CONSOLIDATION_CADENCE=3600

# Consolidation model
CONSOLIDATION_MODEL=deepseek/deepseek-chat

# Pruning: deep prune importance threshold
# PRUNE_DEEP_IMPORTANCE=0.05
# PRUNE_DEEP_ACCESS_COUNT=0
# PRUNE_DEEP_AGE_DAYS=90

# Pruning: consolidation prune insight threshold
# PRUNE_CONSOLID_INSIGHT=0.05
# PRUNE_CONSOLID_AGE_DAYS=60