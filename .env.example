# hmemory environment configuration
# Copy to .env and fill in your values.

# Server
PORT=8080

# Database
DATABASE_URL=postgres://postgres:hmemory@localhost:5432/hmemory

# Embedding provider: "openrouter" or "ollama" (required)
EMBEDDING_PROVIDER=ollama

# OpenRouter (required when EMBEDDING_PROVIDER=openrouter)
# OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=openai/text-embedding-3-small

# Ollama (required when EMBEDDING_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=nomic-embed-text

# Hybrid search: 0.0 = pure BM25, 1.0 = pure vector
HYBRID_ALPHA=0.5

# Memory decay: half-life in days for time-weighted scoring
DECAY_HALF_LIFE_DAYS=30

# Conservative sync_turn: minimum importance score to store a turn
SYNC_TURN_MIN_IMPORTANCE=0.3

# Session strategy: "per-session", "per-directory", "per-repo", "global"
SESSION_STRATEGY=per-session

# Cadence: min turns between prefetch fetches
PREFETCH_CADENCE=1

# Cadence: min turns between sync_turn stores
SYNC_TURN_CADENCE=1

# Cadence: min turns between conclusion generation
CONCLUSION_CADENCE=10

# Max tokens for prefetch context (empty = uncapped)
# CONTEXT_TOKENS=2000

# Cadence: regenerate base context every N turns
BASE_CONTEXT_CADENCE=5